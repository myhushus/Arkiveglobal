---
import TechnologyDetail from '../../../layouts/TechnologyDetail.astro';import {languages,type Lang} from '../../../content';import {publishedTechnologies} from '../../../content/technologies';
export function getStaticPaths(){return publishedTechnologies.flatMap(technology=>languages.map(lang=>({params:{lang,slug:technology.slug},props:{technology}})));}
const lang=Astro.params.lang as Lang;const {technology}=Astro.props;
---
<TechnologyDetail lang={lang} technology={technology}/>
