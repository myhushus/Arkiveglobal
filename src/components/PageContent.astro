---
import { content, href, mail, email, type Lang, type Page } from '../content';
import { publishedTechnologies } from '../content/technologies';
import Arrow from './Arrow.astro';
import CTA from './CTA.astro';
import FieldArt from './FieldArt.astro';
const { lang, page } = Astro.props as { lang: Lang; page: Page };
const t = content[lang];
const head =
  page === 'about'
    ? t.about
    : page === 'technology'
      ? t.technology
      : page === 'licensing'
        ? t.licensing
        : page === 'contact'
          ? t.contactPage
          : t.privacy;
---

<section class:list={['page-hero', { 'contact-hero': page === 'contact' }]}>
  <div class="container">
    <div class="breadcrumb">
      <a href={href(lang)}>{t.nav[0]}</a>
      <span aria-hidden="true">/</span>
      <span>{head.eyebrow}</span>
    </div>
    <p class="eyebrow">{head.eyebrow}</p>
    <h1 class="linebreak">{head.title}</h1>
    <p class="page-lead">{head.lead}</p>
  </div>
  <span class="page-orbit" aria-hidden="true"></span>
</section>
{page === 'about' && (
  <>
    <section class="section">
      <div class="container editorial-grid">
        <p class="eyebrow">01 / {t.about.label}</p>
        <div>
          <h2 class="linebreak">{t.about.heading}</h2>
          <p class="large-copy">{t.about.body}</p>
        </div>
      </div>
    </section>
    <section class="section pale">
      <div class="container">
        <h2>{t.about.valuesTitle}</h2>
        <div class="principles">
          {t.about.values.map(([title, text], i) => (
            <article>
              <span class="number">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <p class="eyebrow">{t.rolesLabel}</p>
        <div class="process-large">
          {t.process.map(([title, text], i) => (
            <div>
              <span class="step-index">0{i + 1}</span>
              <h2>{title}</h2>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <CTA lang={lang} />
  </>
)}
{page === 'technology' && (
  <>
    <section class="section">
      <div class="container">
        <p class="disclosure opening-note">{t.technology.note}</p>
        <div class="technology-list">
          {t.fields.map(([title, text, kind], i) => (
            <article id={kind}>
              <div class="tech-drawing">
                <FieldArt kind={kind} />
              </div>
              <div>
                <p class="eyebrow">
                  0{i + 1} / {t.fieldsLabel}
                </p>
                <h2>{title}</h2>
                <p>{text}</p>
                <a class="text-link" href={mail(title)}>
                  {t.technology.detailLink}
                  <Arrow />
                </a>
              </div>
            </article>
          ))}
        </div>
        {publishedTechnologies.length > 0 && (
          <div class="portfolio">
            <h2>{t.technology.portfolio}</h2>
            {publishedTechnologies.map((tech) => (
              <a class="text-link" href={href(lang, `technology/${tech.slug}`)}>
                {tech.translations[lang].title}
                <Arrow />
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
    <section class="section pale">
      <div class="container editorial-grid">
        <p class="eyebrow">{t.nav[4]}</p>
        <div>
          <h2>{t.technology.detailTitle}</h2>
          <p class="large-copy">{t.technology.detailText}</p>
          <a class="text-link" href={href(lang, 'contact')}>
            {t.contact}
            <Arrow />
          </a>
        </div>
      </div>
    </section>
  </>
)}
{page === 'licensing' && (
  <>
    <section class="section">
      <div class="container editorial-grid">
        <div>
          <p class="eyebrow">01 / {t.nav[3]}</p>
          <h2>{t.licensing.structuresTitle}</h2>
        </div>
        <div class="detailed-list">
          {t.licensing.structures.map(([title, text], i) => (
            <article>
              <span class="number">0{i + 1}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section pale">
      <div class="container">
        <div class="section-heading">
          <h2>{t.licensing.stepsTitle}</h2>
          <p>{t.licensing.stepsIntro}</p>
        </div>
        <ol class="steps">
          {t.licensing.steps.map(([title, text], i) => (
            <li>
              <span class="step-index">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="section">
      <div class="container editorial-grid">
        <h2>{t.licensing.faqTitle}</h2>
        <div class="faq">
          {t.licensing.faqs.map(([q, a]) => (
            <details>
              <summary>
                {q}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <CTA lang={lang} />
  </>
)}
{page === 'contact' && (
  <>
    <section class="section contact-content">
      <div class="container contact-layout">
        <div class="email-panel">
          <p class="eyebrow">{t.contactPage.emailLabel}</p>
          <a
            class="email-address"
            href={mail(lang === 'ko' ? '협력 문의' : 'Business inquiry')}
          >
            {email}
          </a>
          <p>{t.contactPage.fallback}</p>
          <a
            class="button primary"
            href={mail(lang === 'ko' ? '협력 문의' : 'Business inquiry')}
          >
            {t.contactPage.emailAction}
            <Arrow />
          </a>
          <p class="email-note">{t.contactPage.emailNote}</p>
        </div>
        <div class="prepare">
          <h2>{t.contactPage.prepareTitle}</h2>
          <ul>
            {t.contactPage.prepare.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p>{t.contactPage.safety}</p>
          <a class="text-link" href={href(lang, 'privacy')}>
            {t.contactPage.privacyLink}
            <Arrow />
          </a>
        </div>
      </div>
    </section>
    <section class="section pale">
      <div class="container inquiry-types">
        {t.contactPage.types.map(([title, text, subject], i) => (
          <a href={mail(subject)}>
            <span class="number">0{i + 1}</span>
            <h2>{title}</h2>
            <p>{text}</p>
            <Arrow />
          </a>
        ))}
      </div>
    </section>
  </>
)}
{page === 'privacy' && (
  <section class="section">
    <div class="container policy-layout">
      <p class="eyebrow">{t.privacy.updated}</p>
      <div class="policy">
        {t.privacy.sections.map(([title, text], i) => (
          <section>
            <h2>
              <span>0{i + 1}</span>
              {title}
            </h2>
            <p>{text}</p>
            {i === 3 && (
              <a
                class="text-link"
                href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
              >
                {t.privacy.providerLink}
                <Arrow />
              </a>
            )}
          </section>
        ))}
        <a class="text-link" href={`mailto:${email}`}>
          {email}
          <Arrow />
        </a>
      </div>
    </div>
  </section>
)}
