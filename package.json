    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.4.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cheerio": "^1.2.0",
    "sharp": "^0.35.5"
  }
}
